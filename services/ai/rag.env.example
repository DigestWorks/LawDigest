# 별도 비공개 파일에 복사한다. 이 예시에 실제 값을 커밋하지 않는다.
RAG_INTERNAL_TOKEN=
RAG_COLLECTION=lawdigest_rag_active
RAG_QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
RAG_OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RAG_MODEL=gpt-5.4-mini
RAG_EMBEDDING_BACKEND=e5
RAG_EMBEDDING_DIR=/absolute/model/directory
RAG_EMBEDDING_THREADS=2
RAG_VECTOR_SIZE=384
RAG_TOP_K=5
RAG_MIN_SCORE=0.84
RAG_DB_MODE=prod
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
RAG_CONCURRENT_REQUESTS=2
RAG_REQUESTS_PER_WINDOW=5
RAG_WINDOW_SECONDS=300
RAG_DAILY_REQUESTS=500

# 아래 변수만 운영 웹의 비공개 환경 파일에도 설정한다.
# RAG_ENABLED=true
# RAG_INTERNAL_URL=http://127.0.0.1:8110
# RAG_INTERNAL_TOKEN=위와 같은 비밀값
# RAG_PUBLIC_ORIGIN=https://lawdigest.kr
# RAG_TRUST_PROXY_IP=true  # nginx의 덮어쓰기를 확인한 후에만 설정
